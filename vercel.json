{
  "name": "real-estate-map-site",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/contact-photo\\.(jpg|jpeg|png|gif|webp)",
      "dest": "/contact-photo.$1"
    },
    {
      "src": "/(.*\\.(jpg|jpeg|png|gif|webp|svg|ico|pdf|txt|xml|json))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
} 